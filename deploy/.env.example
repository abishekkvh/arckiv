# Copy values into Render Environment; do not commit real credentials.
NODE_ENV=production
FILE_STORAGE=gridfs
CLIENT_URL=https://arckiv.web.app
MONGODB_URI=mongodb+srv://REPLACE_USER:REPLACE_URL_ENCODED_PASSWORD@REPLACE_ACTIVE_ATLAS_HOST/arckiv?retryWrites=true&w=majority
FIREBASE_PROJECT_ID=whatsapp-8fbf7
FIREBASE_CLIENT_EMAIL=REUSE_EXISTING_SERVER_FIREBASE_CLIENT_EMAIL
FIREBASE_PRIVATE_KEY=REUSE_EXISTING_SERVER_FIREBASE_PRIVATE_KEY
GEMINI_API_KEY=REUSE_EXISTING_SERVER_GEMINI_API_KEY
ENABLE_VECTOR_SEARCH=false
CLASSIFIER_MIN_CONFIDENCE=0.45
CLASSIFIER_ALLOW_DEMO=false
MAX_AI_CONCURRENCY=1
# CLASSIFIER_URL and model ID are injected by deploy/start.py.
# CLIENT_URL above is the intended site, not a claim that it exists yet.
