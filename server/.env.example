PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/arckiv
# Use gridfs for any cloud deploy: local files disappear on free hosts.
FILE_STORAGE=gridfs
FIREBASE_PROJECT_ID=whatsapp-8fbf7
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
GEMINI_API_KEY=
# Optional. Keyword search always works; Atlas vector index required to enable.
ENABLE_VECTOR_SEARCH=false
# Local Machine Learning Classifier service (FastAPI on port 8001)
CLASSIFIER_URL=http://127.0.0.1:8001
CLASSIFIER_MIN_CONFIDENCE=0.45
CLASSIFIER_ALLOW_DEMO=false

# Set by the combined Render runtime; not needed for local development.
CLASSIFIER_REQUIRED=false
MAX_AI_CONCURRENCY=1
